{
  "name": "checkable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:load": "tsx scripts/generate-load.ts",
    "dataset:build": "tsx --conditions=react-server scripts/build-dataset.ts",
    "dataset:check": "tsx --conditions=react-server scripts/build-dataset.ts --check",
    "dataset:demo": "tsx scripts/serve-dataset.ts",
    "smoke:live": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/smoke-live.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@typesafe-ai/sdk": "0.6.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "papaparse": "^5.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
